{
  "version": 2,
  "builds": [
    {
      "src": "flask_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/public/sitemap.xml"
    },
    {
      "src": "/dg-logo.png",
      "dest": "/public/dg-logo.png"
    },
    {
      "src": "/OG-image-dg.png",
      "dest": "/public/OG-image-dg.png"
    },
    {
      "src": "/(.*)",
      "dest": "flask_app.py"
    }
  ]
}
